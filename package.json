{
    "name": "life-calendar",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "migrate": "node-pg-migrate up --migration-file-language js --migrations-dir database/migrations",
        "migrate:down": "node-pg-migrate down --migration-file-language js --migrations-dir database/migrations",
        "test": "vitest run --reporter verbose"
    },
    "dependencies": {
        "@vercel/blob": "^2.3.3",
        "jose": "^6.2.2",
        "next": "^15.0.0",
        "pg": "^8.13.3",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.3",
        "dotenv": "^16.4.7",
        "node-pg-migrate": "^7.9.1",
        "tailwindcss": "^4.1.3",
        "vitest": "^3.1.1"
    }
}
